{
  "name": "need-for-madness",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "golden:update": "UPDATE_GOLDEN=1 vitest run test/golden",
    "lint": "eslint src test *.config.js",
    "format": "prettier --write src test *.config.js",
    "format:check": "prettier --check src test *.config.js"
  },
  "devDependencies": {
    "acorn": "8.14.0",
    "eslint": "9.17.0",
    "globals": "15.14.0",
    "prettier": "3.3.3",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  }
}
